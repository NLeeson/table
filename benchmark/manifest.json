{
  "benchmark": "table-irbench-mini",
  "benchmark_version": "0.2.0",
  "description": "Deterministic semantic-preserving LLVM IR optimization benchmark",
  "task_policy": {
    "pure_single_function": true,
    "allow_globals": false,
    "allow_external_calls": false,
    "allow_inline_asm": false,
    "allow_target_intrinsics": false,
    "max_candidate_bytes": 65536
  },
  "toolchain": {
    "llvm_version": "22.1.0",
    "alive2_revision": "0dc2be5f04ccb61caebb909a610968cb2348f196",
    "alive2_args": ["--disable-undef-input"],
    "target_triple": "x86_64-unknown-linux-gnu",
    "mcpu": "haswell",
    "isa_intent": "AVX2",
    "llc_args": ["-O3"],
    "llvm_mca_args": []
  },
  "families": [
    {"name": "reductions", "instances": 4},
    {"name": "scans", "instances": 4},
    {"name": "sorting_selection", "instances": 4},
    {"name": "bitops", "instances": 4},
    {"name": "vector_arithmetic", "instances": 4},
    {"name": "permutations", "instances": 4}
  ],
  "scoring": {
    "correctness_gate": "alive-tv",
    "verified_outcome": "verified status with positive baseline and candidate throughput",
    "non_verified_outcome": "non-verified status with no throughput measurements",
    "performance_metric": "llvm-mca Block RThroughput",
    "task_score": "baseline_throughput / candidate_throughput",
    "invalid_score": 0,
    "aggregate_speedup": "geometric_mean_of_verified_task_scores",
    "failure_inclusive_quality": "arithmetic_mean_of_all_normalized_task_scores",
    "task_outcome_order": "non_verified_is_bottom; verified_outcomes_compare_by_score_and_reasoning_token_pareto_dominance",
    "task_efficiency_metric": "tagged(1000 * normalized_task_score / reasoning_tokens)",
    "task_efficiency_zero_tokens": "non_verified_is_zero; verified_is_unbounded",
    "task_efficiency_missing_tokens": "verified_is_unknown; non_verified_remains_zero_with_coverage_reported",
    "pooled_efficiency_metric": "1000 * sum_normalized_scores / sum_reasoning_tokens_all_attempts",
    "pooled_efficiency_role": "descriptive_only_not_completion_sensitive",
    "reciprocal_efficiency_metric": "sum_reasoning_tokens_all_attempts / sum_normalized_scores"
  }
}
